#!/bin/sh
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
config=$root/.gatekeeper/config.toml
: "${GATEKEEPER_JOB_START:=$(date +%s)}"
export GATEKEEPER_JOB_START
cd "$root"
refuse() {
    echo "gatekeeper wrapper: $*" >&2
    exit 2
}
if grep -Eq '^pin *= *"checkout"' "$config"; then
    cargo build --quiet --locked -p gatekeeper
    exec "${CARGO_TARGET_DIR:-$root/target}/debug/gatekeeper" "$@"
fi
field() { sed -n "/^\[pin\]/,/^\[/s/^$1 *= *\"\([^\"]*\)\".*/\1/p" "$config"; }
case "$(uname -s)-$(uname -m)" in
    Linux-x86_64) target=x86_64-unknown-linux-gnu ;;
    Darwin-arm64) target=aarch64-apple-darwin ;;
    *) refuse "no gatekeeper asset for $(uname -s)-$(uname -m)" ;;
esac
version=$(field version)
sum=$(field "$target")
[ -n "$version" ] && [ -n "$sum" ] || refuse "$config: [pin] needs version and $target"
sha() { { sha256sum "$1" 2>/dev/null || shasum -a 256 "$1"; } | cut -d' ' -f1; }
dir=${XDG_CACHE_HOME:-$HOME/.cache}/gatekeeper/bin/$sum
bin=$dir/gatekeeper
if [ ! -f "$bin" ]; then
    mkdir -p "$dir"
    curl -sSfL -o "$bin.part" "https://github.com/jirathip-dev/gatekeeper/releases/download/v$version/gatekeeper-$target"
    [ "$(sha "$bin.part")" = "$sum" ] || { rm -f "$bin.part"; refuse "gatekeeper $version: sha256 differs from [pin]: refused"; }
    chmod +x "$bin.part"
    mv "$bin.part" "$bin"
    echo "fetched gatekeeper $version (sha256 ok)" >&2
fi
[ "$(sha "$bin")" = "$sum" ] || refuse "$bin: sha256 differs from [pin]: refused; delete it to fetch again"
exec "$bin" "$@"
