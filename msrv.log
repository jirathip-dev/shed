2026-11-18T04:41:07.1803622Z bail() {
2026-11-18T04:41:07.1803881Z   printf '::error::install-action: %s\n' "$*"
2026-11-18T04:41:07.1804192Z   exit 1
2026-11-18T04:41:07.1804386Z }
2026-11-18T04:41:07.1804742Z # If /bin/sh is dash, environment variable containing % is not imported, but is fine
2026-11-18T04:41:07.1805313Z # because it also means that it will not be exposed to subprocess.
2026-11-18T04:41:07.1805737Z if /usr/bin/env | grep -Eq '^BASH_FUNC_'; then
2026-11-18T04:41:07.1806279Z   bail 'bash function injection via BASH_FUNC_ environment variable is not allowed for security reasons'
2026-11-18T04:41:07.1806775Z fi
2026-11-18T04:41:07.1806996Z if ! command -v bash >/dev/null; then
2026-11-18T04:41:07.1807346Z   if grep -Eq '^ID=alpine' /etc/os-release; then
2026-11-18T04:41:07.1807783Z     printf '::group::Install packages required for install-action (bash)\n'
2026-11-18T04:41:07.1808228Z     # NB: sync with apk_install in main.sh
2026-11-18T04:41:07.1808543Z     if command -v sudo >/dev/null; then
2026-11-18T04:41:07.1808864Z       sudo apk --no-cache add bash
2026-11-18T04:41:07.1809178Z     elif command -v doas >/dev/null; then
2026-11-18T04:41:07.1809490Z       doas apk --no-cache add bash
2026-11-18T04:41:07.1809757Z     else
2026-11-18T04:41:07.1809971Z       apk --no-cache add bash
2026-11-18T04:41:07.1810231Z     fi
2026-11-18T04:41:07.1810442Z     printf '::endgroup::\n'
2026-11-18T04:41:07.1810693Z   else
2026-11-18T04:41:07.1810919Z     bail 'this action requires bash'
2026-11-18T04:41:07.1811189Z   fi
2026-11-18T04:41:07.1811374Z fi
